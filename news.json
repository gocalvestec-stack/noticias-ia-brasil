let noticias = [];

// Carrega o arquivo JSON
async function carregarNoticias(){

    try{

        const resposta = await fetch("noticias.json");

        noticias = await resposta.json();

        mostrarNoticias(noticias);

        criarCategorias();

    }catch(error){

        console.log("Erro ao carregar notícias:", error);

    }

}


// Cria os botões automaticamente
function criarCategorias(){

    const areaCategorias = document.getElementById("categorias");

    if(!areaCategorias) return;


    let categorias = [
        ...new Set(
            noticias.map(n => n.category)
        )
    ];


    areaCategorias.innerHTML = `

    <button onclick="mostrarNoticias(noticias)">
        Todas
    </button>

    ${
        categorias.map(cat => `

        <button onclick="filtrarCategoria('${cat}')">
            ${cat}
        </button>

        `).join("")
    }

    `;

}


// Filtrar categoria
function filtrarCategoria(categoria){

    let resultado = noticias.filter(n =>

        n.category &&
        n.category.toLowerCase() === categoria.toLowerCase()

    );


    mostrarNoticias(resultado);

}



// Mostrar cards
function mostrarNoticias(lista){


    const container = document.getElementById("noticias");


    if(!container) return;


    container.innerHTML = "";


    lista.forEach(noticia => {


        container.innerHTML += `

        <div class="card-noticia">


            <img src="${noticia.image}">


            <div class="conteudo">


            <span class="categoria">
                ${noticia.category}
            </span>


            <h2>
                ${noticia.title}
            </h2>


            <p>
                ${limparTexto(noticia.description)}
            </p>


            <a href="${noticia.url}" 
            target="_blank">

                Ler notícia completa

            </a>


            </div>


        </div>


        `;


    });


}



// Remove HTML das descrições
function limparTexto(texto){

    if(!texto) return "";

    return texto
    .replace(/<[^>]*>/g,"")
    .substring(0,180)+"...";

}



// iniciar
carregarNoticias();
